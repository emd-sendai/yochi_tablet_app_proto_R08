              "color": "#1F78B4"
            }
          ],
          "fontSize": 18
        },
        "body": {
          "textRuns": [
            {
              "text": "　建物の移転に伴う動産（家財道具、商品、諸材料等）については、荷造り、運搬等に必要な費用の補償をします。",
              "bold": false,
