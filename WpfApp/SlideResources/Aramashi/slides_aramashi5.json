              "imagePath": "aramashi5_5.png"
            }
          ]
        }
      },
      {
        "subtitle": {
          "textRuns": [
            {
              "text": "⑤仮住居等に要する費用の補償",
              "bold": true,
              "color": "#1F78B4"
            }
          ],
          "fontSize": 18
        },
        "body": {
          "textRuns": [
            {
              "text": "　建物移転等に通常要する期間中、仮住居や動産の一時保管を必要とする",
              "bold": true,
              "color": "#1F78B4"
            },
            {
              "text": "ものと認められる場合には、その使用に要する費用を補償します。",
              "bold": false,
              "color": "#000000"
            }
          ],
          "fontSize": 16
