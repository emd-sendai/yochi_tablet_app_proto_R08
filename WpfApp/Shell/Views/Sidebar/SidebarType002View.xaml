<UserControl x:Class="WpfApp.Shell.Views.Sidebar.SidebarType002View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Shell.Views.Sidebar"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">
    <Grid>
        <StackPanel Background="{DynamicResource MaterialDesignPaper}" HorizontalAlignment="Left">
            
            <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar99" Margin="1,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay,  
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=99}"
                         Command="{Binding GoToMenuCommand}">
                <StackPanel Orientation="Horizontal" >
                    <materialDesign:PackIcon Kind="Home" Width="25" Height="35" Margin="0,0,5,0"/>
                    <TextBlock Text="メインメニュー"  FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar0" Margin="2,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=0}"
                         Command="{Binding GoToAramashiMenuCommand}">
                <TextBlock Text="補償のあらまし" Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
            </RadioButton>

            <Expander IsExpanded="{Binding IsAramashiExpanderOpen, Mode=TwoWay}">
                <Expander.Header>
                    <TextBlock Text="用地補償の手順" FontSize="20" FontWeight="Bold" />
                </Expander.Header>
                <StackPanel Orientation="Vertical" Margin="20,0,0,0">

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar1" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=1}"
                                 Command="{Binding GoToSection1Command}">
                        <TextBlock Text="{Binding AramashiButtons[0].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar2" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=2}"
                                 Command="{Binding GoToSection2Command}">
                        <TextBlock Text="{Binding AramashiButtons[1].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar3" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay,  
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=3}"
                                 Command="{Binding GoToSection3Command}">
                        <TextBlock Text="{Binding AramashiButtons[2].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar4" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=4}"
                                 Command="{Binding GoToSection4Command}">
                        <TextBlock Text="{Binding AramashiButtons[3].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar5" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=5}"
                                 Command="{Binding GoToSection5Command}">
                        <TextBlock Text="{Binding AramashiButtons[4].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar6" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=6}"
                                 Command="{Binding GoToSection6Command}">
                        <TextBlock Text="{Binding AramashiButtons[5].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar7" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=7}"
                                 Command="{Binding GoToSection7Command}">
                        <TextBlock Text="{Binding AramashiButtons[6].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar8" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=8}"
                                 Command="{Binding GoToSection8Command}">
                        <TextBlock Text="{Binding AramashiButtons[7].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar9" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=9}"
                                 Command="{Binding GoToSection9Command}">
                        <TextBlock Text="{Binding AramashiButtons[8].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar10" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=10}"
                                 Command="{Binding GoToSection10Command}">
                        <TextBlock Text="{Binding AramashiButtons[9].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="{Binding IsOthersExpanderOpen, Mode=TwoWay}" >
                <Expander.Header>
                    <TextBlock Text="その他" FontSize="20" FontWeight="Bold"/>
                </Expander.Header>
                <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar11" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=11}"
                                 Command="{Binding GoToOthers001Command}">
                        <TextBlock Text="{Binding OthersButtons[0].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar12" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=12}"
                                 Command="{Binding GoToOthers002Command}">
                        <TextBlock Text="{Binding OthersButtons[1].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar13" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=13}"
                                 Command="{Binding GoToOthers003Command}">
                        <TextBlock Text="{Binding OthersButtons[2].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar14" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=14}"
                                 Command="{Binding GoToOthers004Command}">
                        <TextBlock Text="{Binding OthersButtons[3].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ExpanderRadioButtonStyle}" GroupName="Sidebar15" 
                                 IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                             Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=15}"
                                 Command="{Binding GoToOthers005Command}">
                        <TextBlock Text="{Binding OthersButtons[4].SidebarLabelText}" 
                                   Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
                    </RadioButton>
                </StackPanel>
            </Expander>

            <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar16" Margin="2,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=16}"
                         Command="{Binding GoToDocumentMenuCommand}">
                <TextBlock Text="各種資料" Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
            </RadioButton>

        </StackPanel>
    </Grid>
</UserControl>
