<UserControl x:Class="WpfApp.Shell.Views.Sidebar.SidebarType001View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Shell.Views.Sidebar"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <StackPanel Background="{DynamicResource MaterialDesignPaper}" HorizontalAlignment="Left">
        <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar99" Margin="1,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay,  
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=99}"
                         Command="{Binding GoToMenuCommand}">
            <StackPanel Orientation="Horizontal" >
                <materialDesign:PackIcon Kind="Home" Width="25" Height="35" Margin="0,0,5,0"/>
                <TextBlock Text="メインメニュー"  FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </RadioButton>

        <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar0" Margin="2,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=0}"
                         Command="{Binding GoToAramashiMenuCommand}">
            <TextBlock Text="補償のあらまし" Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
        </RadioButton>
        <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" GroupName="Sidebar2" Margin="2,5,0,0" 
                         IsChecked="{Binding SelectedMode, Mode=OneWay, 
                                     Converter={StaticResource SelectedModeToBoolConverter}, ConverterParameter=1}"
                         Command="{Binding GoToDocumentMenuCommand}">
            <TextBlock Text="各種資料" Style="{StaticResource ExpanderWrapTextBlockStyle}"/>
        </RadioButton>
    </StackPanel>
    
</UserControl>
