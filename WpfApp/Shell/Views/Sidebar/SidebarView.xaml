<UserControl x:Class="WpfApp.Shell.Views.Sidebar.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Shell.Views.Sidebar"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <!-- サイドバー -->
        <ContentPresenter Content="{Binding SidebarContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
