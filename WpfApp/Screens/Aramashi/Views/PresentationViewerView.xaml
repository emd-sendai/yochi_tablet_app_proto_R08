<UserControl x:Class="WpfApp.Screens.Aramashi.Views.PresentationViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid>
        <!-- Gridの行定義 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <!-- あらましメニューボタン -->
        <Button Grid.Row="0" Style="{StaticResource MaterialDesignFlatButton}" 
            Margin="10" Command="{Binding GoToAramashiMenuCommand}"
                HorizontalAlignment="Left" FontSize="24" Height="40">
            <StackPanel Orientation="Horizontal" >
                <materialDesign:PackIcon Kind="OrderBoolAscending" Width="25" Height="35" Margin="0,0,5,0"/>
                <TextBlock Text="補償のあらまし"  FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <!-- 基本ボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- 拡大ボタン-->
            <Button Grid.Row="0"  Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,5,10" Command="{Binding ZoomInCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="PlusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="拡大" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- 縮小ボタン-->
            <Button Grid.Row="0"  Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,5,10" Command="{Binding ZoomOutCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MinusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="縮小" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- 本手順TOPへ戻るボタン -->
            <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,5,10" Command="{Binding GoToTopPageCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="ArrowCollapseLeft" Style="{StaticResource ITButtonIconStyle}" Width="25"/>
                    <TextBlock Text="{Binding TopButtonText}" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- ホームアイコンボタン -->
            <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,10,10" Command="{Binding GoToMenuCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Home" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="メインメニュー" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ナビゲーション -->
        <!-- 前へボタン -->
        <StackPanel  HorizontalAlignment="Left" Margin="20,15,0,15" Grid.Row="1" >
            <Button Content="◀ 前へ" Command="{Binding PrevCommand}"  Height="40" Width="90"
                    Style="{StaticResource CommonButtonStyle}" FontSize="18"
                    Visibility="{Binding CanGoPrev, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
        </StackPanel>
        <!-- セクション概要 -->
        <StackPanel HorizontalAlignment="Center" Margin="15" Grid.Row="1" Orientation="Horizontal">
            <!-- セクションタイトル -->
            <TextBlock Text="{Binding CurrentSlide.TitleText}" FontSize="24.5" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- 動画アイコンボタン -->
            <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" Margin="5,0,0,0" 
                    Visibility="{Binding CurrentSlide.Video, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding OpenVideoPlayerCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MoviePlay" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="動画" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- PDF資料アイコンボタン -->
            <Button Style="{StaticResource IconTextButtonStyle}" Margin="5,0,0,0" 
                    Visibility="{Binding CurrentSlide.Document, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding OpenPdfDocumentsCommand}" CommandParameter="{Binding CurrentSlide.DocumentFolderName}">
                <StackPanel Orientation="Vertical">
                    <materialDesign:PackIcon Kind="File" Style="{StaticResource ITButtonIconStyle}" />
                    <TextBlock Text="パンフレット" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- 次へボタン -->
        <StackPanel  HorizontalAlignment="Right" Margin="15" Grid.Row="1">
            <Button Content="次へ ▶" Command="{Binding NextCommand}" Height="40" Width="90"
                    Style="{StaticResource CommonButtonStyle}" FontSize="18"
                    Visibility="{Binding CanGoNext, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto" PanningMode="Both"
                      IsManipulationEnabled="True"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" 
                      Style="{StaticResource MaterialDesignScrollViewer}" >

            <Grid ManipulationStarting="Border_ManipulationStarting"
                  ManipulationDelta="Border_ManipulationDelta"
                  RenderTransformOrigin="0.5,0"  
                  VerticalAlignment="Top" HorizontalAlignment="Center">

                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Grid.LayoutTransform>

                <local:PresentationPage x:Name="PageControl" />

            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="16" Padding="5" CornerRadius="10,0,0,0" IsHitTestVisible="False" 
                Background="{DynamicResource MaterialDesignPaper}" Opacity="0.85"
                Height="27" Width="55">

                <TextBlock Text="{Binding CurrentSlide.PageIndex}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>

        </Border>

    </Grid>
    
</UserControl>
