<Window x:Class="WpfApp.Screens.Aramashi.Views.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
        mc:Ignorable="d"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--TextBlock Text="{Binding Title}"
                       FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Grid.Row="0"-->

            <!-- 署名メッセージ（署名日） -->
            <TextBlock Text="{Binding SignMessage}" Grid.Row="0"
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25" />


            <TextBlock Text="署名欄" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="30,10,0,10" Grid.Row="1"
                       VerticalAlignment="Bottom"/>
            <Button Content="クリア" Width="100" Height="40" FontSize="18" Margin="0,10,18,5" HorizontalAlignment="Right" Grid.Row="1"
                    Command="{Binding ClearCommand}" Style="{StaticResource CommonButtonStyle}"
                    CommandParameter="{Binding ElementName=SignatureCanvas}"/>

            <!-- 署名欄（InkCanvas） -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="2" CornerRadius="4"  Height="250" Width="750">
                <InkCanvas x:Name="SignatureCanvas" Background="White" Margin="5" Height="250" Width="750"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="保存" Width="100" Height="50" Margin="5,5,15,5" FontSize="24"
                    Command="{Binding SaveCommand}"  Style="{StaticResource CommonButtonStyle}"
                    CommandParameter="{Binding ElementName=SignatureCanvas}"/>
                <Button Content="PDF出力" Width="130" Height="50" Margin="15,5,5,5" FontSize="24"
                    Command="{Binding PrintCommand}"  Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>

            <Button Content="× 画面を閉じる" Width="200" Height="50" Margin="5,5,18,5" FontSize="20" Grid.Row="4" 
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Command="{Binding CloseCommand}"  Style="{StaticResource MaterialDesignFlatButton}" />
        </Grid>
    </Grid>
</Window>
