<Window x:Class="WpfApp.Screens.Aramashi.Views.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
        mc:Ignorable="d"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ここにタイトル（バインド予定）" 
                       FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Grid.Row="0"/>

            <TextBlock Text="令和〇年○月○日上記について説明を受けました。（バインド予定）" 
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" Grid.Row="1"/>


            <TextBlock Text="署名欄" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="10" Grid.Row="2"
                       VerticalAlignment="Bottom"/>
            <Button Content="クリア" Width="100" Height="40" FontSize="18" Margin="5" HorizontalAlignment="Right" Grid.Row="2"
                    Command="{Binding ClearCommand}" Style="{StaticResource CommonButtonStyle}"
                    CommandParameter="{Binding ElementName=SignatureCanvas}"/>

            <!-- 署名欄（InkCanvas） -->
            <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="2" CornerRadius="4">
                <InkCanvas x:Name="SignatureCanvas" Background="White" Margin="5"/>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="保存" Width="100" Height="50" Margin="5,5,15,5" FontSize="24"
                    Command="{Binding SaveCommand}"  Style="{StaticResource CommonButtonStyle}"
                    CommandParameter="{Binding ElementName=SignatureCanvas}"/>
                <Button Content="PDF出力" Width="130" Height="50" Margin="15,5,5,5" FontSize="24"
                    Command="{Binding PrintCommand}"  Style="{StaticResource CommonButtonStyle}"
                    CommandParameter="{Binding ElementName=SignatureCanvas}"/>
            </StackPanel>

            <Button Content="閉じる" Width="100" Height="50" Margin="5,5,10,5" FontSize="20" Grid.Row="4" HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"  Style="{StaticResource CommonButtonStyle}" />
        </Grid>
    </Grid>
</Window>
