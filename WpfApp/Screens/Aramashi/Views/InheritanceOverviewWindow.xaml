<Window x:Class="WpfApp.Screens.Aramashi.Views.InheritanceOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
        mc:Ignorable="d"
        Title="相続の概要" d:DesignHeight="600" d:DesignWidth="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10,20,10">
            <TextBlock Text="相続人の範囲と順位" FontSize="24" Foreground="Black" FontWeight="Bold" TextDecorations="Underline"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- 拡大ボタン-->
            <Button Style="{StaticResource IconTextButtonStyle}" Margin="5,10,5,10" Command="{Binding ZoomInCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="PlusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="拡大" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- 縮小ボタン-->
            <Button Style="{StaticResource IconTextButtonStyle}" Margin="5,10,5,10" Command="{Binding ZoomOutCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MinusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="縮小" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Content="× 画面を閉じる" Style="{StaticResource CommonButtonStyle}"
                    Margin="20,10,10,10" FontSize="15" Height="45" Command="{Binding CloseCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="Both"
                  IsManipulationEnabled="True"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Grid.Row="2"
                  Style="{StaticResource MaterialDesignScrollViewer}">
            <Border ManipulationStarting="Border_ManipulationStarting"
                ManipulationDelta="Border_ManipulationDelta"
                RenderTransformOrigin="0.5,0" >
                
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Border.LayoutTransform>

                <Grid Grid.Row="1" HorizontalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="400"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="420"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1" Background="White"  x:Name="FamilyTreeGrid">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 線を描画する Canvas -->
                            <Canvas x:Name="LineCanvas" IsHitTestVisible="False">
                                <Line x:Name="ParentsVLine" Stroke="Gray" StrokeThickness="5"/>
                                <Line x:Name="ParentsHLine" Stroke="Gray" StrokeThickness="5"/>
                                <Line x:Name="SiblingsVLine" Stroke="Gray" StrokeThickness="5"/>
                                <Line x:Name="DecedentVLine" Stroke="Gray" StrokeThickness="5"/>
                                <Line x:Name="CoupleHLine" Stroke="Gray" StrokeThickness="5"/>
                                <Line x:Name="ChildrenVLine" Stroke="Gray" StrokeThickness="5"/>
                            </Canvas>

                            <!-- 親 -->
                            <StackPanel Grid.Row="0" Grid.Column="1" x:Name="Parents" Width="80" Background="White"
                                Orientation="Vertical" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <TextBlock Text="第２順位" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E573A1" FontSize="13"/>
                                <TextBlock Text="親：直系尊属" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 親（補足） -->
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="10"  TextWrapping="Wrap"
                               Margin="5,5,0,5"
                               Text="※父母が死亡している場合は祖父母"/>

                            <!-- 兄弟姉妹 -->
                            <StackPanel Grid.Row="2" Grid.Column="0" x:Name="Siblings" Width="80" Background="White"
                                Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="第３順位" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#FB8C00" FontSize="13"/>
                                <TextBlock Text="兄弟姉妹" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 兄弟姉妹（補足） -->
                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="10"  TextWrapping="Wrap"
                               Margin="5,0,5,5"
                               Text="※兄弟姉妹が死亡していてその兄弟姉妹に子がいる場合はその子"/>

                            <!-- 被相続人 -->
                            <StackPanel Grid.Row="2" Grid.Column="2" x:Name="Decedent" Width="80" Background="White"
                                Orientation="Vertical" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <TextBlock Text="被相続人" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="【死亡】" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#D64545" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 配偶者 -->
                            <StackPanel Grid.Row="2" Grid.Column="4" x:Name="Spouse" Width="80" Background="White"
                                Orientation="Vertical" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <TextBlock Text="配偶者" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="※常に相続人" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#388E3C" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 子 -->
                            <StackPanel Grid.Row="4" Grid.Column="3" x:Name="Children" Width="80"  Background="White"
                                Orientation="Vertical" VerticalAlignment="Center"  HorizontalAlignment="Center">
                                <TextBlock Text="第１順位" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#42A5F5" FontSize="13"/>
                                <TextBlock Text="子：直系卑属" HorizontalAlignment="Center" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                    <materialDesign:PackIcon Kind="Person" Style="{StaticResource FamilyTreeIconStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 子（補足） -->
                            <TextBlock Grid.Row="5" Grid.Column="3" FontSize="10"  TextWrapping="Wrap"
                               Text="※子が死亡している場合は孫"/>

                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>

                        </Grid>

                        <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,15,0,0">
                            <!-- 注釈 -->
                            <TextBlock TextWrapping="Wrap">
                        <Run Text="*現行法による相続の例" Foreground="#1F78B4"/>
                        <Run Text="（昭和５６年１月１日以降）" Foreground="#1F78B4" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="相続人になる方と順位に注意" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="現行法では"/>
                        <Run Text="常に配偶者" FontWeight="Bold"/>
                        <Run Text="、とともに"/>
                        <Run Text="①子、②親、③兄弟姉妹の順" FontWeight="Bold"/>
                            </TextBlock>

                            <!-- 配偶者のみボタン -->
                            <Button  Height="55" Margin="20,20,20,0" HorizontalContentAlignment="Left"
                            Command="{Binding SelectCaseCommand}" CommandParameter="spouseOnly" >
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCase}" Value="spouseOnly">
                                                <Setter Property="Background" Value="#388E3C"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#388E3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                            <Run Text="配偶者のみの場合"/>
                            <LineBreak/>
                            <Run Text="　配偶者：100％"/>
                                </TextBlock>
                            </Button>

                            <!-- 配偶者と子ボタン -->
                            <Button Height="55" Margin="20,20,20,0" HorizontalContentAlignment="Left"
                            Command="{Binding SelectCaseCommand}" CommandParameter="spouseAndChidren" >
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCase}" Value="spouseAndChidren">
                                                <Setter Property="Background" Value="#42A5F5"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#42A5F5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                            <Run Text="配偶者と"/>
                            <Run Text="子（第１順位）" TextDecorations="Underline"/>
                            <Run Text="の場合"/>
                            <LineBreak/>
                            <Run Text="　配偶者：1/2　子：1/2"/>
                                </TextBlock>
                            </Button>

                            <!-- 配偶者と親ボタン -->
                            <Button Height="55" Margin="20,20,20,0" HorizontalContentAlignment="Left"
                            Command="{Binding SelectCaseCommand}" CommandParameter="spouseAndParents" >
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCase}" Value="spouseAndParents">
                                                <Setter Property="Background" Value="#E573A1"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E573A1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                            <Run Text="配偶者と"/>
                            <Run Text="親（第２順位）" TextDecorations="Underline"/>
                            <Run Text="の場合"/>
                            <LineBreak/>
                            <Run Text="　配偶者：2/3　親：1/3"/>
                                </TextBlock>
                            </Button>

                            <!-- 配偶者と兄弟姉妹ボタン -->
                            <Button Height="55" Margin="20,20,20,0" HorizontalContentAlignment="Left"
                            Command="{Binding SelectCaseCommand}" CommandParameter="spouseAndSiblings" >
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="LightGray"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCase}" Value="spouseAndSiblings">
                                                <Setter Property="Background" Value="#FB8C00"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#FB8C00"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock>
                            <Run Text="配偶者と"/>
                            <Run Text="兄弟姉妹（第３順位）" TextDecorations="Underline"/>
                            <Run Text="の場合"/>
                            <LineBreak/>
                            <Run Text="　配偶者：3/4　兄弟姉妹：1/4"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20">
                        <TextBlock Text="※上位の順位者がいる場合は、下位の順位者は相続人になれません。" FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                        <TextBlock Text="　例）被相続人死亡時に子がいれば、父母は相続人になれません。" FontSize="18"/>
                    </StackPanel>

                </Grid>

            </Border>
        </ScrollViewer>
        
    </Grid>
</Window>
