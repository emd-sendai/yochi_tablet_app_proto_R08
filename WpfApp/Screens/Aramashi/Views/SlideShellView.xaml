<UserControl x:Class="WpfApp.Screens.Aramashi.Views.SlideShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <!-- Gridの行定義 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
         </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <!-- あらましメニューボタン -->
        <Button Grid.Row="0" Style="{StaticResource MaterialDesignFlatButton}" 
            Margin="10" Command="{Binding GoToAramashiMenuCommand}"
                HorizontalAlignment="Left" FontSize="24" Height="40">
            <StackPanel Orientation="Horizontal" >
                <materialDesign:PackIcon Kind="OrderBoolAscending" Width="25" Height="35" Margin="0,0,5,0"/>
                <TextBlock Text="用地補償の手順"  FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <!-- 基本ボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- 拡大ボタン-->
            <Button Grid.Row="0"  Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,5,10" Command="{Binding ZoomInCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="PlusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="拡大" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- 縮小ボタン-->
            <Button Grid.Row="0"  Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,5,10" Command="{Binding ZoomOutCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MinusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="縮小" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>

            </Button>
            <!-- ホームアイコンボタン -->
            <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,10,10" Command="{Binding GoToMenuCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Home" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="メインメニュー" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ナビゲーション -->
        <!-- 前へボタン -->
        <StackPanel  HorizontalAlignment="Left" Margin="20,15,0,15" Grid.Row="1" >
            <Button Content="◀ 前へ" Command="{Binding PrevCommand}"  Height="40" Width="90"
                    Style="{StaticResource CommonButtonStyle}" FontSize="18"
                    Visibility="{Binding CanGoPrev, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <!-- セクション概要 -->
        <StackPanel HorizontalAlignment="Center" Margin="15" Grid.Row="1" Orientation="Horizontal">
            <!-- セクションタイトル -->
            <TextBlock Text="{Binding CurrentSlide.Title}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- 動画アイコンボタン 動画表示コマンドと動画がない場合は非表示か薄くする機能実装予定-->
            <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                    Margin="5,0,0,0" >
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MoviePlay" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="動画" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- 次へボタン -->
        <StackPanel  HorizontalAlignment="Right" Margin="15" Grid.Row="1">
            <Button Content="次へ ▶" Command="{Binding NextCommand}" Height="40" Width="90"
                    Style="{StaticResource CommonButtonStyle}" FontSize="18"
                    Visibility="{Binding CanGoNext, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PanningMode="Both"
                  IsManipulationEnabled="True"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Grid.Row="2"
                  Style="{StaticResource MaterialDesignScrollViewer}">

            <Border ManipulationStarting="Border_ManipulationStarting"
                ManipulationDelta="Border_ManipulationDelta"
                RenderTransformOrigin="0.5,0" >

                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Border.LayoutTransform>
                
                <!-- メインコンテンツ -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20,0,20,20" >
                    
                    <!-- エリア１ -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <!-- テキスト１ -->
                        <TextBlock Text="{Binding CurrentSlide.Description}" TextWrapping="Wrap" FontSize="18" Margin="0,0,10,0"
                               MaxWidth="500"/>
                        <!-- 画像１ -->
                        <Image Stretch="Uniform" StretchDirection="DownOnly" Visibility="Visible" VerticalAlignment="Top"
                           Source="{Binding CurrentSlide.ImagePath}" MaxWidth="200" MaxHeight="200"/>
                    </StackPanel>

                    <!-- エリア２ -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <!-- テキスト２ -->
                        <TextBlock  TextWrapping="Wrap" FontSize="18" Margin="0,0,10,0"
                               MaxWidth="500"/>
                        <!-- 画像２ -->
                        <Image Stretch="Uniform" StretchDirection="DownOnly" Visibility="Visible" VerticalAlignment="Top"
                            MaxWidth="200" MaxHeight="200"/>
                    </StackPanel>

                    <!-- エリア３ -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <!-- テキスト３ -->
                        <TextBlock  TextWrapping="Wrap" FontSize="18" Margin="0,0,10,0"
                               MaxWidth="500"/>
                        <!-- 画像３ -->
                        <Image Stretch="Uniform" StretchDirection="DownOnly" Visibility="Visible" VerticalAlignment="Top"
                            MaxWidth="200" MaxHeight="200"/>
                    </StackPanel>

                </StackPanel>

            </Border>
        </ScrollViewer>


    </Grid>

</UserControl>
