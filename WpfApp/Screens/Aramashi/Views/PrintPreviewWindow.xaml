<Window x:Class="WpfApp.Screens.Aramashi.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
        mc:Ignorable="d"
        Title="PDFプレビュー" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <DocumentViewer Document="{Binding Document}" Loaded="DocViewer_Loaded">
        <DocumentViewer.CommandBindings>
            <CommandBinding Command="ApplicationCommands.Print"
                        Executed="Print_Executed"
                        CanExecute="Print_CanExecute"/>
        </DocumentViewer.CommandBindings>
    </DocumentViewer>

</Window>
