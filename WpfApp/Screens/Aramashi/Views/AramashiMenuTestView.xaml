<UserControl x:Class="WpfApp.Screens.Aramashi.Views.AramashiMenuTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Aramashi.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <!-- Gridの行定義 -->
        <Grid.RowDefinitions>
            <!-- ヘッダー（１行目） -->
            <RowDefinition Height="Auto" />
            <!-- メインコンテンツ（２行目） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- １行目 -->
        <!-- ページタイトル -->
        <TextBlock Grid.Row="0" Text="用地補償のあらまし" Foreground="#3F51B5"
            FontSize="30" FontWeight="Bold" Margin="0,10,0,10"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        </TextBlock>

        <!-- ボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- ホームアイコンボタン -->
            <Button Grid.Row="0" Style="{StaticResource MaterialDesignIconButton}" 
                Margin="5,10,10,10" Command="{Binding GoToMenuCommand}">
                <materialDesign:PackIcon Kind="Home" Width="40" Height="40" />
            </Button>
        </StackPanel>

        <!-- ２行目 -->
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <!-- Gridの列定義（２行目） -->
            <Grid.ColumnDefinitions>
                <!-- 用地補償の手順（１列目） -->
                <ColumnDefinition Width="3*" />
                <!-- その他（２列目） -->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- １列目 -->
            <Grid Grid.Column="0">
                <!-- Gridの列定義（１列目） -->
                <Grid.RowDefinitions>
                    <!-- エリアタイトル（１行目） -->
                    <RowDefinition Height="Auto" />
                    <!-- エリアコンテンツ（２行目） -->
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- エリアタイトル -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="用地補償の手順" FontSize="25" FontWeight="Bold" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <!-- 動画アイコンボタン -->
                    <Button Style="{StaticResource MaterialDesignIconButton}" Margin="5,0,0,0" 
                            Command="{Binding OpenVideoPlayerCommand}">
                        <materialDesign:PackIcon Kind="MoviePlay" Width="30" Height="30" />
                    </Button>
                    <!-- PDF資料アイコンボタン -->
                    <Button Style="{StaticResource MaterialDesignIconButton}" Margin="5,0,0,0" >
                        <materialDesign:PackIcon Kind="File" Width="30" Height="30" />
                    </Button>
                </StackPanel>

                <!-- エリアコンテンツ -->

                <!-- Gridの列定義（ボタン配置エリア） -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- ボタン配置エリア（１列目） -->
                    <StackPanel  Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top"
                                 Margin="0,20,0,0">

                        <!-- 手順１ -->
                        <Button 
                                FontSize="16" Height="70" Margin="20,0,15,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="１" />
                                <LineBreak />
                                <Run Text="事業計画等の説明" />
                            </TextBlock>

                        </Button>
                        <!-- 手順２ -->
                        <Button 
                                FontSize="16" Height="70" Margin="20,0,15,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="２" />
                                <LineBreak />
                                <Run Text="用地幅杭の設置" />
                            </TextBlock>
                        </Button>
                        <!-- 手順３ -->
                        <Button 
                                FontSize="16" Height="70" Margin="20,0,15,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="３" />
                                <LineBreak />
                                <Run Text="用地測量物件等の調査" />
                            </TextBlock>
                        </Button>
                        <!-- 手順４ -->
                        <Button 
                                FontSize="16" Height="70" Margin="20,0,15,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="４" />
                                <LineBreak />
                                <Run Text="土地調書・物件調書の確認" />
                            </TextBlock>
                        </Button>
                        <!-- 手順５ -->
                        <Button 
                                FontSize="16" Height="70" Margin="20,0,15,0"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="５" />
                                <LineBreak />
                                <Run Text="補償金の算定" />
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- ボタン配置エリア（２列目） -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,20,0,0">

                        <!-- 手順６ -->
                        <Button 
                                FontSize="16" Height="70" Margin="15,0,20,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="６" />
                                <LineBreak />
                                <Run Text="用地説明・協議（用地交渉）" />
                            </TextBlock>
                        </Button>
                        <!-- 手順７ -->
                        <Button 
                                FontSize="16" Height="70" Margin="15,0,20,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="７" />
                                <LineBreak />
                                <Run Text="契約" />
                            </TextBlock>
                        </Button>
                        <!-- 手順８ -->
                        <Button 
                                FontSize="16" Height="70" Margin="15,0,20,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="８" />
                                <LineBreak />
                                <Run Text="補償金の前金払" />
                            </TextBlock>
                        </Button>
                        <!-- 手順９ -->
                        <Button 
                                FontSize="16" Height="70" Margin="15,0,20,10"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="９" />
                                <LineBreak />
                                <Run Text="土地登記・物件移転" />
                                <LineBreak />
                                <Run Text="・土地の引渡し" />
                            </TextBlock>
                        </Button>
                        <!-- 手順１０ -->
                        <Button 
                                FontSize="16" Height="70" Margin="15,0,20,0"
                                Style="{StaticResource AramashiTestButtonStyle}">
                            <TextBlock Style="{StaticResource WrapTextBlockStyle}">
                                <Run Text="１０" />
                                <LineBreak />
                                <Run Text="補償金の後金払・一括払" />
                            </TextBlock>
                        </Button>

                    </StackPanel>

                </Grid>



            </Grid>

            <!-- ２列目 -->
            <Grid Grid.Column="1">
                <!-- Gridの列定義（１列目） -->
                <Grid.RowDefinitions>
                    <!-- エリアタイトル（１行目） -->
                    <RowDefinition Height="Auto" />
                    <!-- エリアコンテンツ（２行目） -->
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- エリアタイトル -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" >
                    <TextBlock Text="その他" FontSize="25" FontWeight="Bold" Margin="0,0,0,5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- エリアコンテンツ -->
                <!-- ボタン配置エリア -->
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,20,0,0">

                    <!-- 代替地 -->
                    <Button 
                                FontSize="16" Height="70" Margin="20,0,20,10"
                                Style="{StaticResource OthersTestButtonStyle}">
                        <TextBlock Text="代替地" Style="{StaticResource WrapTextBlockStyle}"/>
                    </Button>
                    <!-- 税金等 -->
                    <Button 
                                FontSize="16" Height="70" Margin="20,0,20,10"
                                Style="{StaticResource OthersTestButtonStyle}">
                        <TextBlock Text="税金等" Style="{StaticResource WrapTextBlockStyle}"/>
                    </Button>
                    <!-- 損失補償基準 -->
                    <Button 
                                FontSize="16" Height="70" Margin="20,0,20,10"
                                Style="{StaticResource OthersTestButtonStyle}">
                        <TextBlock Text="損失補償基準" Style="{StaticResource WrapTextBlockStyle}"/>
                    </Button>
                    <!-- 用地六法 -->
                    <Button 
                                FontSize="16" Height="70" Margin="20,0,20,10"
                                Style="{StaticResource OthersTestButtonStyle}">
                        <TextBlock Text="用地六法" Style="{StaticResource WrapTextBlockStyle}"/>
                    </Button>
                    <!-- その他 -->
                    <Button 
                                FontSize="16" Height="70" Margin="20,0,20,0"
                                Style="{StaticResource OthersTestButtonStyle}">
                        <TextBlock Text="その他" Style="{StaticResource WrapTextBlockStyle}"/>
                    </Button>
                </StackPanel>

            </Grid>

        </Grid>



    </Grid>
</UserControl>
