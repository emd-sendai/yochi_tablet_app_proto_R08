<UserControl x:Class="WpfApp.Screens.Documents.Views.DocumentMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Documents.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <!-- Gridの行定義 -->
        <Grid.RowDefinitions>
            <!-- ヘッダー（１行目） -->
            <RowDefinition Height="Auto" />
            <!-- メインコンテンツ（２行目） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <!-- ページタイトル -->
        <TextBlock Grid.Row="0" Text="各種資料" Foreground="#3F51B5"
            FontSize="30" FontWeight="Bold" Margin="0,10,0,10"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        </TextBlock>

        <!-- ホームアイコンボタン -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- ホームアイコンボタン -->
            <Button Grid.Row="0" Style="{StaticResource MaterialDesignIconButton}" 
                Margin="5,10,10,10" Command="{Binding GoToMenuCommand}">
                <materialDesign:PackIcon Kind="Home" Width="40" Height="40" />
            </Button>
        </StackPanel>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- 事業資料（１行目） -->
                <RowDefinition Height="1*"/>
                <!-- 地権者個別資料（２行目） -->
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- 事業資料エリア -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 事業名のコンボボックス -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ComboBox  materialDesign:HintAssist.Hint="事業を選択してください" 
                               Style="{StaticResource DocumentComboBoxStyle}" Width="500">
                        <ComboBoxItem Content="国道１号○○業務" />
                        <ComboBoxItem Content="国道２号○○業務" />
                        <ComboBoxItem Content="国道３号○○業務" />
                    </ComboBox>
                </StackPanel>
                <!-- 事業資料ボタンエリア（上段） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" 
                            Margin="0,0,0,10">
                    <!-- 公図 -->
                    <Button FontSize="20" Margin="20,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="公図" />
                        </TextBlock>
                    </Button>
                    <!-- 登記簿 -->
                    <Button FontSize="20"  Margin="0,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="登記簿" />
                                <LineBreak />
                                <Run Text="（土地・建物）" />
                        </TextBlock>
                    </Button>
                    <!-- 用地平面図 -->
                    <Button FontSize="20"  Margin="0,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="用地平面図" />
                        </TextBlock>
                    </Button>
                    <!-- 面積計算書 -->
                    <Button FontSize="20"  Margin="0,0,20,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="面積計算書" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <!-- 事業資料ボタンエリア（下段） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- 地積測量図 -->
                    <Button FontSize="20"  Margin="20,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="地積測量図" />
                        </TextBlock>
                    </Button>
                    <!-- 登記簿 -->
                    <Button FontSize="20"  Margin="0,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="写真" />
                                <LineBreak />
                                <Run Text="（全体）" />
                        </TextBlock>
                    </Button>
                    <!-- 事業計画図 -->
                    <Button FontSize="20"  Margin="0,0,15,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="事業計画図" />
                        </TextBlock>
                    </Button>
                    <!-- その他 -->
                    <Button FontSize="20"  Margin="0,0,20,0" 
                            Style="{StaticResource DocumentWorkButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="その他" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 地権者個別資料エリア -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 地権者コンボボックス -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ComboBox  materialDesign:HintAssist.Hint="地権者ユーザを選択してください" 
                               Style="{StaticResource DocumentComboBoxStyle}" Width="400" >
                        <ComboBoxItem Content="用地　太郎" />
                        <ComboBoxItem Content="用地　次郎" />
                        <ComboBoxItem Content="用地　三郎" />
                    </ComboBox>
                    <TextBlock Text="様" FontSize="23" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 地権者個別資料ボタンエリア（上段） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- 配置図　調査表 -->
                    <Button FontSize="20" Margin="20,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="配置図" />
                                <LineBreak />
                                <Run Text="調査表" />
                        </TextBlock>
                    </Button>
                    <!-- 算定書 -->
                    <Button FontSize="20" Margin="0,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="算定書" />
                        </TextBlock>
                    </Button>
                    <!-- 写真（個別） -->
                    <Button FontSize="20" Margin="0,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="写真" />
                                <LineBreak />
                                <Run Text="（個別）" />
                        </TextBlock>
                    </Button>
                    <!-- 相続関係図（説明用） -->
                    <Button FontSize="20" Margin="0,0,20,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="相続関係図" />
                                <LineBreak />
                                <Run Text="（説明用）" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <!-- 地権者個別資料ボタンエリア（下段） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- 調書 -->
                    <Button FontSize="20" Margin="20,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="調書" />
                        </TextBlock>
                    </Button>
                    <!-- 補償金提示書 -->
                    <Button FontSize="20" Margin="0,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="補償金提示書" />
                        </TextBlock>
                    </Button>
                    <!-- 契約書 -->
                    <Button FontSize="20" Margin="0,0,15,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="契約書" />
                        </TextBlock>
                    </Button>
                    <!-- その他 -->
                    <Button FontSize="20" Margin="0,0,20,0" 
                            Style="{StaticResource DocumentLandownerButtonStyle}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="その他" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
