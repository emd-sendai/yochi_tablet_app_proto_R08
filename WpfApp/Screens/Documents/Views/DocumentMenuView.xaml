<UserControl x:Class="WpfApp.Screens.Documents.Views.DocumentMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Documents.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid >
        <Grid.RowDefinitions>
            <!-- 事業資料（１行目） -->
            <RowDefinition Height="1*"/>
            <!-- 地権者個別資料（２行目） -->
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- 事業資料エリア -->
        <Grid Grid.Row="0" Margin="10,20,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 事業コンボボックス -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ComboBox ItemsSource="{Binding Works}" DisplayMemberPath="WorkName" SelectedItem="{Binding SelectedWork}"
                    FontSize="22" Margin="10,0,10,0" Padding="8" Width="500" Background="White"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                    materialDesign:HintAssist.Hint="事業を選択してください"/>
            </StackPanel>

            <!-- 事業資料ボタンエリア -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20,20,20,0">
                <!-- 事業資料ボタンエリア（上段） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <!-- 公図 -->
                    <Button Margin="0,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument01Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[0].Content}"/>
                    </Button>
                    <!-- 登記簿 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument02Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[1].Content}"/>
                    </Button>
                    <!-- 用地平面図 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument03Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[2].Content}"/>
                    </Button>
                    <!-- 面積計算書 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument04Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[3].Content}"/>
                    </Button>
                </StackPanel>
                <!-- 事業資料ボタンエリア（下段） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <!-- 地積測量図 -->
                    <Button Margin="0,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument05Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[4].Content}"/>
                    </Button>
                    <!-- 登記簿 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument06Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[5].Content}"/>
                    </Button>
                    <!-- 事業計画図 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument07Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[6].Content}"/>
                    </Button>
                    <!-- その他 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentWorksButtonStyle}"
                            Command="{Binding OpenWorkDocument08Command}" IsEnabled="{Binding IsWorkSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding WorkButtons[7].Content}"/>
                    </Button>
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- 地権者個別資料エリア -->
        <Grid Grid.Row="1" Margin="10,10,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 地権者選択エリア -->
            <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
                <!-- 地権者個別資料ボタン -->
                <Button Style="{StaticResource CommonButtonStyle}"
                        Width="500" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding OpenPasswordDialogCommand}"
                        Visibility="{Binding IsNotPasswordCorrect, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsEnabled="{Binding IsWorkSelected}">
                    <TextBlock Style="{StaticResource WrapTextBlockStyle}" >
                                <Run Text="地権者個別資料（パスワードあり）" FontSize="20" />
                                <LineBreak />
                                <Run Text="※配置図・調査表、算定書、調書、損失補償協議書、契約関係書類等" FontSize="15"/>
                    </TextBlock>
                </Button>
                <!-- 地権者コンボボックス -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsPasswordCorrect, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox ItemsSource="{Binding WorkLandowners}" DisplayMemberPath="LandownerName" 
                              SelectedItem="{Binding SelectedLandowner}"
                              FontSize="22" Margin="37,0,10,0" Padding="8" Width="500" Background="White"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                              materialDesign:HintAssist.Hint="地権者を選択してください"/>
                    <TextBlock Text="様" FontSize="22" Margin="5,8"/>
                </StackPanel>
            </StackPanel>

            <!-- 地権者個別資料ボタンエリア -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20,20,20,0">
                <!-- 地権者個別資料ボタンエリア（上段） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsPasswordCorrect, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" >
                    <!-- 配置図　調査表 -->
                    <Button Margin="0,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument01Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[0].Content}"/>
                    </Button>
                    <!-- 算定書 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument02Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[1].Content}"/>
                    </Button>
                    <!-- 写真（個別） -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument03Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[2].Content}"/>
                    </Button>
                    <!-- 相続関係図（説明用） -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument04Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[3].Content}"/>
                    </Button>
                </StackPanel>
                <!-- 地権者個別資料ボタンエリア（下段） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0"
                        Visibility="{Binding IsPasswordCorrect, Converter={StaticResource BooleanToHiddenVisibilityConverter}}" >
                    <!-- 調書 -->
                    <Button Margin="0,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument05Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[4].Content}"/>
                    </Button>
                    <!-- 補償金提示書 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument06Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[5].Content}"/>
                    </Button>
                    <!-- 契約関係書類 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument07Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[6].Content}"/>
                    </Button>
                    <!-- その他 -->
                    <Button Margin="20,0,0,0" Style="{StaticResource DocumentLandownerButtonStyle}"
                        Command="{Binding OpenLandownerDocument08Command}" IsEnabled="{Binding IsLandownerSelected}">
                        <TextBlock Style="{StaticResource WrapTextBlockStyle}" Text="{Binding LandownerButtons[7].Content}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
