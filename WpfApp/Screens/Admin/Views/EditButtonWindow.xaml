<Window x:Class="WpfApp.Screens.Admin.Views.EditButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
        mc:Ignorable="d"
        Title="" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">
    <Grid>
        <!-- Gridの行定義 -->
        <Grid.RowDefinitions>
            <!-- プレビューエリア（１行目） -->
            <RowDefinition Height="Auto" />
            <!-- 入力エリア（２行目） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Button Style="{StaticResource AramashiButtonStyle}" Width="180" Height="70">
                <TextBlock Text="{Binding PreviewText}" Style="{StaticResource WrapTextBlockStyle}"/>
            </Button>
        </StackPanel>

        <StackPanel Margin="20" Orientation="Vertical" Grid.Row="1" >
            <TextBlock Text="ボタン名を入力してください（上限：10文字×3行）" FontSize="18" Margin="0,0,0,12"/>
            <!-- Line 1 -->
            <TextBox Text="{Binding Line1, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,2" Height="40" Background="White" FontSize="18"
                     materialDesign:HintAssist.Hint="１行目"/>
            <TextBlock Text="{Binding Line1Remaining, StringFormat=残り文字数: {0}}" 
                   FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>

            <!-- Line 2 -->
            <TextBox Text="{Binding Line2, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,2" Height="40" Background="White"  FontSize="18"
                     materialDesign:HintAssist.Hint="２行目"/>
            <TextBlock Text="{Binding Line2Remaining, StringFormat=残り文字数: {0}}" 
                   FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>

            <!-- Line 3 -->
            <TextBox Text="{Binding Line3, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,2" Height="40" Background="White"  FontSize="18"
                     materialDesign:HintAssist.Hint="３行目"/>
            <TextBlock Text="{Binding Line3Remaining, StringFormat=残り文字数: {0}}" 
                   FontSize="12" Foreground="Gray" Margin="0,0,0,12"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button Content="キャンセル" Command="{Binding CancelCommand}" Style="{StaticResource CommonButtonStyle}" Margin="0,0,20,0"
                        Width="100" Height="50" FontSize="17"/>
                <Button Content="OK" Command="{Binding ConfirmCommand}" Style="{StaticResource CommonButtonStyle}"
                        Width="80" Height="50" FontSize="20"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
