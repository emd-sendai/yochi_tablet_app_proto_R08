<UserControl x:Class="WpfApp.Screens.Admin.Views.AdminPasswordSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- エラーメッセージ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="16" Foreground="#D32F2F"
                       TextWrapping="Wrap"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="パスワードの変更" FontSize="20" FontWeight="SemiBold"/>
            <!-- 現在のパスワード -->
            <StackPanel Orientation="Horizontal" Margin="8,20,0,0">
                <TextBlock Text="現在のパスワード" FontSize="18"  Foreground="{StaticResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="*" FontSize="18" Foreground="#D32F2F" 
                           Visibility="{Binding IsPassError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <PasswordBox x:Name="CurrentPwBox" 
                     Margin="0,10" Padding="8,0" Height="40" Background="White" FontSize="18" MaxLength="20"
                     PreviewTextInput="PasswordBox_PreviewTextInput" DataObject.Pasting="PasswordBox_Pasting"/>
            
            <!-- 新しいパスワード -->
            <StackPanel Orientation="Horizontal" Margin="8,25,0,0">
                <TextBlock Text="新しいパスワード" FontSize="18"  Foreground="{StaticResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="*" FontSize="18" Foreground="#D32F2F" 
                           Visibility="{Binding IsNewPassError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <PasswordBox x:Name="NewPwBox" 
                     Margin="0,10" Padding="8,0" Height="40" Background="White" FontSize="18" 
                     materialDesign:HintAssist.Hint="4文字以上20文字以下の半角英数字" MaxLength="20"
                     PreviewTextInput="PasswordBox_PreviewTextInput" DataObject.Pasting="PasswordBox_Pasting"/>
            
            <!-- 新しいパスワード（確認用） -->
            <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                <TextBlock Text="新しいパスワード（確認用）" FontSize="18"  Foreground="{StaticResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="*" FontSize="18" Foreground="#D32F2F" 
                           Visibility="{Binding IsConfirmPassError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <PasswordBox x:Name="ConfirmPwBox" 
                     Margin="0,10" Padding="8,0" Height="40" Background="White" FontSize="18" 
                     materialDesign:HintAssist.Hint="4文字以上20文字以下の半角英数字" MaxLength="20"
                     PreviewTextInput="PasswordBox_PreviewTextInput" DataObject.Pasting="PasswordBox_Pasting"/>
        </StackPanel>

        <!-- 保存ボタン -->
        <StackPanel Grid.Row="2" Margin="0,30,0,20">
            <Button Content="変更を保存" Style="{StaticResource CommonButtonStyle}" FontSize="18"
                    Width="150" Height="50" 
                    Click="ChangePasswordButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
