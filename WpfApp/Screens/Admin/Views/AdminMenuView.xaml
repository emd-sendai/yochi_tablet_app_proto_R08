<UserControl x:Class="WpfApp.Screens.Admin.Views.AdminMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Height="600" VerticalAlignment="Top" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="" FontSize="18" Foreground="#3F51B5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="管理資料" FontSize="22" Height="60" Width="250" Margin="0,0,0,0"
                    Command="{Binding GoToAdminDocumentCommand}" Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="メイン機能表示設定" FontSize="18" Foreground="#3F51B5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="補償のあらまし" FontSize="22" Height="60" Width="250" Margin="0,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
                <Button Content="各種資料" FontSize="22" Height="60" Width="250" Margin="20,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="事業・地権者情報設定" FontSize="18" Foreground="#3F51B5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="事業情報" FontSize="22" Height="60" Width="200" Margin="0,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
                <Button Content="地権者情報" FontSize="22" Height="60" Width="200" Margin="20,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
                <Button Content="事業実績" FontSize="22" Height="60" Width="200" Margin="20,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="アプリデータ設定" FontSize="18" Foreground="#3F51B5" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="管理者パスワード" FontSize="22" Height="60" Width="200" Margin="0,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
                <Button Content="資料一覧出力" FontSize="22" Height="60" Width="200" Margin="20,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
                <Button Content="データ共有・引継ぎ" FontSize="22" Height="60" Width="200" Margin="20,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Orientation="Vertical">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="データ初期化" FontSize="22" Height="60" Width="200" Margin="0,0,0,0"
                    Command="{Binding Command}" Style="{StaticResource CommonButtonStyle}"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
