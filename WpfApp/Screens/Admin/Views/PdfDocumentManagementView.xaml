<UserControl x:Class="WpfApp.Screens.Admin.Views.PdfDocumentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Drawer部分 -->
            <ColumnDefinition Width="*"/>
            <!-- メインコンテンツ部分 -->
        </Grid.ColumnDefinitions>

        <materialDesign:DrawerHost x:Name="DrawerHostControl" Grid.Column="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   IsLeftDrawerOpen="{Binding IsLeftDrawerOpen, Mode=TwoWay}">
            <!-- サイドバー -->
            <materialDesign:DrawerHost.LeftDrawerContent>
                <StackPanel Background="{DynamicResource MaterialDesignPaper}">
                    <TextBlock Text="管理メニュー" 
                           FontSize="22" Margin="20"/>
                    <Button Content="表示設定" FontSize="20" VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding GoToDisplaySetttingsCommand}"/>
                    <Button Content="管理資料" FontSize="20" VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Command="{Binding GoToAdminDocumentCommand}"/>
                </StackPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>
        </materialDesign:DrawerHost>

        <Grid Grid.Column="1">
            <!-- Gridの行定義 -->
            <Grid.RowDefinitions >
                <!-- ヘッダー（１行目） -->
                <RowDefinition Height="Auto" />
                <!-- メインコンテンツ（２行目） -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- １行目 -->
            <!-- ページタイトル -->
            <TextBlock Grid.Row="0" Text="{Binding Title}" 
                       Foreground="#3F51B5" FontSize="30" FontWeight="Bold" Margin="0,10,0,10" 
                       HorizontalAlignment="Center" VerticalAlignment="Center">
            </TextBlock>

            <!-- ボタン -->
            <!-- ヘッダー（左側） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- 管理メニューアイコンボタン -->
                <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                        Margin="10"  Command="{Binding ToggleDrawerCommand}">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="Menu" Style="{StaticResource ITButtonIconStyle}"/>
                        <TextBlock Text="管理メニュー" Style="{StaticResource ITButtonTextStyle}"/>
                    </StackPanel>
                </Button>
                <!-- 戻るボタン -->
                <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                        Margin="5,10,5,10"  Command="{Binding GoBackCommand}">
                    <StackPanel Orientation="Vertical">
                        <materialDesign:PackIcon Kind="ArrowBack" Style="{StaticResource ITButtonIconStyle}"/>
                        <TextBlock Text="戻る" Style="{StaticResource ITButtonTextStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ヘッダー（右側） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- ホームアイコンボタン -->
                <Button Grid.Row="0" Style="{StaticResource IconTextButtonStyle}" 
                Margin="5,10,10,10" Command="{Binding GoToMenuCommand}">
                    <StackPanel Orientation="Vertical" >
                        <materialDesign:PackIcon Kind="Home" Style="{StaticResource ITButtonIconStyle}"/>
                        <TextBlock Text="メインメニュー" Style="{StaticResource ITButtonTextStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Margin="20" Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="380"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <TextBlock Text="{Binding SubTitle}" FontSize="16.5" Margin="10,0,20,10" 
                               FontWeight="SemiBold"/>

                    <ListBox FontSize="16" Height="320" Style="{DynamicResource BorderedListBoxStyle}"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.PanningMode="VerticalOnly"
                             ScrollViewer.PanningDeceleration="0.001"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                             DisplayMemberPath="FullFileName">
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="新規追加" Width="130" Height="50" FontSize="20" Margin="0,0,40,0" 
                            VerticalAlignment="Top" Style="{StaticResource CommonButtonStyle}" 
                            Command="{Binding AddCommand}"/>
                    <Button Content="差し替え" Width="130" Height="50" FontSize="20" Margin="0,0,40,0" 
                            VerticalAlignment="Top" Style="{StaticResource CommonButtonStyle}" 
                            IsEnabled="{Binding SelectedDocument, Converter={StaticResource NullToBoolConverter}}"
                            Command="{Binding UpdateCommand}"/>
                    <Button Content="削除" Width="90" Height="50" FontSize="20" Margin="0,0,0,0" 
                            VerticalAlignment="Top" Style="{StaticResource CommonButtonStyle}" 
                            IsEnabled="{Binding SelectedDocument, Converter={StaticResource NullToBoolConverter}}"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
