<Window x:Class="WpfApp.Screens.Admin.Views.WorkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
        mc:Ignorable="d"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid VerticalAlignment="Top" Margin="20" Width="700" Height="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="#3F51B5" FontSize="23" FontWeight="Bold"
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- エラーメッセージ -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="16" Foreground="#D32F2F"/>
        </StackPanel>

        <!-- 入力エリア -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 事業ID -->
            <TextBlock Grid.Column="0" Grid.Row="0" Text="事業ID" FontSize="18" Margin="0,0,40,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding WorkId}" FontSize="18" 
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            
            <!-- 事業名 -->
            <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,0,40,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock  Text="事業名" FontSize="18" />
                <TextBlock Text="*" FontSize="18" Foreground="#D32F2F" 
                           Visibility="{Binding IsWorkNameError, Converter={StaticResource BooleanToHiddenVisibilityConverter}}"/>
            </StackPanel>
            <TextBox Grid.Column="1" Grid.Row="1" x:Name="WorkNameTextBox" Text="{Binding Work.WorkName}" 
                     Background="White" FontSize="18" MaxLength="30" Padding="8,0" Height="35"
                     materialDesign:HintAssist.Hint="30文字以内の事業名を入力してください"/>
        </Grid>

        <!-- ボタンエリア -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="登録"  FontSize="20" Width="130" Height="50"  Margin="0,0,0,0"
                    Style="{StaticResource CommonButtonStyle}" Command="{Binding ConfirmCommand}"/>
            <Button Content="キャンセル"  FontSize="20" Width="130" Height="50"  Margin="50,0,0,0"
                    Style="{StaticResource CommonButtonStyle}" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
