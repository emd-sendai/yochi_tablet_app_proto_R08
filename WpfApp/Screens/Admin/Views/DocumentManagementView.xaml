<UserControl x:Class="WpfApp.Screens.Admin.Views.DocumentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <Grid VerticalAlignment="Top" Margin="20" Width="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ComboBox Grid.Row="0" ItemsSource="{Binding Works}" DisplayMemberPath="DisplayLabel" 
                  SelectedItem="{Binding SelectedWork, Mode=TwoWay}"
                    FontSize="22" Padding="8" Background="White"
                    materialDesign:HintAssist.Hint="事業を選択してください"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0,134,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="事業全般資料" Style="{StaticResource CommonButtonStyle}" Height="200" Width="200" FontSize="23"
                        Command="{Binding GoToWorkDocumentManagementCommand}"
                        IsEnabled="{Binding SelectedWork, Converter={StaticResource NullToBoolConverter}}"/>
                <Button Content="地権者個別資料" Style="{StaticResource CommonButtonStyle}" Height="200" Width="200" FontSize="23" Margin="70,0,0,0"
                        Command="{Binding GoToLandownerDocumentManagementCommand}"
                        IsEnabled="{Binding SelectedWork, Converter={StaticResource NullToBoolConverter}}"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
