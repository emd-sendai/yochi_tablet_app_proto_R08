<Window x:Class="WpfApp.Screens.Admin.Views.VideoChapterEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Screens.Admin.Views"
        mc:Ignorable="d"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">

            <TextBlock Text="チャプターの開始時間を入力してください" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource MaterialDesign.Brush.Primary}"/>

            <TextBlock Text="※動画の総再生時間【00 : 00 : 00.0】" FontSize="15" Foreground="Gray" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

                    <TextBox Width="50" Height="50" Background="White" FontSize="18" TextAlignment="Center"
                             materialDesign:HintAssist.Hint="hh" MaxLength="2"
                             PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberOnlyTextBox_Pasting"
                             IsEnabled="{Binding CanEditStart}"
                             Text="{Binding Chapteritem.StartHour, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(時間)" Foreground="Gray" TextAlignment="Center" Margin="0,20,0,0"/>

                </StackPanel>

                <TextBlock Text=":" FontSize="18" Margin="10"/>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

                    <TextBox Width="50" Height="50" Background="White" FontSize="18" TextAlignment="Center"
                             materialDesign:HintAssist.Hint="mm" MaxLength="2"
                             PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberOnlyTextBox_Pasting"
                             IsEnabled="{Binding CanEditStart}"
                             Text="{Binding Chapteritem.StartMinute, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="(分)" Foreground="Gray" TextAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>

                <TextBlock Text=":" FontSize="18" Margin="10"/>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    
                    <StackPanel Orientation="Horizontal">

                        <TextBox Width="50" Height="50" Background="White" FontSize="18" TextAlignment="Center"
                                 materialDesign:HintAssist.Hint="ss" MaxLength="2"
                                 PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                 DataObject.Pasting="NumberOnlyTextBox_Pasting"
                                 IsEnabled="{Binding CanEditStart}"
                                 Text="{Binding Chapteritem.StartSecond, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="." FontSize="18" Margin="10,20,10,0"/>

                        <TextBox Width="30" Height="50" Background="White" FontSize="18" TextAlignment="Center"
                                 materialDesign:HintAssist.Hint="f" MaxLength="1"
                                 PreviewTextInput="NumberOnlyTextBox_PreviewTextInput"
                                 DataObject.Pasting="NumberOnlyTextBox_Pasting"
                                 IsEnabled="{Binding CanEditStart}"
                                 Text="{Binding Chapteritem.StartFraction, UpdateSourceTrigger=PropertyChanged}"/>
                        
                    </StackPanel>

                    <TextBlock Text="(秒)" Foreground="Gray" TextAlignment="Center" Margin="0,20,0,0"/>

                </StackPanel>

            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="チャプターの名称を入力してください" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                       Foreground="{StaticResource MaterialDesign.Brush.Primary}"/>
            <TextBox Width="300" Background="White" Height="40" FontSize="18" Padding="5"
                     materialDesign:HintAssist.Hint="例）チャプター１" MaxLength="30"
                     Text="{Binding Chapteritem.Text, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="キャンセル" Width="130" Height="50" FontSize="20" Margin="0,0,40,0" 
                            VerticalAlignment="Top" Style="{StaticResource CommonButtonStyle}" 
                            Command="{Binding CancelCommand}" />

            <Button Content="OK" Width="90" Height="50" FontSize="20" Margin="0,0,0,0" 
                            VerticalAlignment="Top" Style="{StaticResource CommonButtonStyle}" 
                            Command="{Binding ConfirmCommand}" />
        </StackPanel>
        
    </Grid>

</Window>
