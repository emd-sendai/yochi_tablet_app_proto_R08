<Window x:Class="WpfApp.Common.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Title="VideoPlayer" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <MediaElement Grid.Row="0" x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Source="{Binding VideoPath}" />
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
            <!-- 再生ボタン -->
            <Button Command="{Binding PlayCommand}" CommandParameter="{Binding ElementName=Player}" Margin="5"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Play" Width="40" Height="40" />
            </Button>
            <!-- 一時停止ボタン（押下後に再生ボタンを押下するとその時点から再生される） -->
            <Button Command="{Binding PauseCommand}" CommandParameter="{Binding ElementName=Player}" Margin="5"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Pause" Width="40" Height="40" />
            </Button>
            <!-- 停止ボタン（押下後に再生ボタンを押下すると最初から再生される） -->
            <Button Command="{Binding StopCommand}" CommandParameter="{Binding ElementName=Player}" Margin="5"
                    Style="{StaticResource MaterialDesignIconButton}">
                <materialDesign:PackIcon Kind="Stop" Width="40" Height="40" />
            </Button>
            <!-- 閉じるボタン -->
            <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Content="閉じる" Margin="5" Style="{StaticResource CommonButtonStyle}" FontSize="18" VerticalAlignment="Center">
            </Button>
        </StackPanel>
    </Grid>
</Window>
