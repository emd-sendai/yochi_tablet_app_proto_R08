<Window x:Class="WpfApp.Common.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Title="" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement Grid.Row="0" x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Source="{Binding VideoSource}" />

        <Slider Grid.Row="1" Minimum="0" Maximum="{Binding Duration.TotalSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/> 

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
            <!-- チャプター遷移（前へ）ボタン -->
            <Button Command="{Binding PreviousChapterCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="SkipPrevious" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="前へ" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 巻き戻しボタン -->
            <Button Command="{Binding RewindCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Rewind10" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="巻き戻し" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 再生ボタン -->
            <Button Command="{Binding PlayCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Play" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="再生" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 一時停止ボタン（押下後に再生ボタンを押下するとその時点から再生される） -->
            <Button Command="{Binding PauseCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Pause" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="一時停止" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 停止ボタン（押下後に再生ボタンを押下すると最初から再生される） -->
            <Button Command="{Binding StopCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Stop" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="停止" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 早送りボタン -->
            <Button Command="{Binding ForwardCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="FastForward10" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="早送り" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- チャプター遷移（次へ）ボタン -->
            <Button Command="{Binding PreviousChapterCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="SkipNext" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="次へ" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 閉じるボタン -->
            <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Content="閉じる" Margin="5" Style="{StaticResource CommonButtonStyle}" FontSize="18" VerticalAlignment="Center">
            </Button>
        </StackPanel>
    </Grid>
</Window>
