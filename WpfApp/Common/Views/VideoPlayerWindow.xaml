<Window x:Class="WpfApp.Common.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Title="" d:DesignHeight="600" d:DesignWidth="800"
        MinHeight="600" MinWidth="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 動画 -->
        <Grid Grid.Row="0">
            <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" 
                      MediaOpened="Media_MediaOpened" MediaFailed="Media_MediaFailed"/>
        </Grid>

        <!-- シークバー -->
        <Grid Grid.Row="1">
            <Slider Minimum="0" Maximum="{Binding Duration.TotalSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                PreviewMouseDown="Slider_PreviewMouseDown" PreviewMouseUp="Slider_PreviewMouseUp"/>
        </Grid>

        <!-- 再生時間 -->
        <StackPanel Grid.Row="2" Margin="10,0,0,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="{Binding TimeDisplay}" 
                       FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,80,10">
            <!-- 再生速度コンボボックス -->
            <StackPanel Orientation="Vertical" Margin="5,5,10,5">
                <ComboBox ItemsSource="{Binding SpeedOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedSpeed, Mode=TwoWay}" 
                      HorizontalContentAlignment="Center" VerticalAlignment="Top"
                      Height="35" Width="70" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="再生速度" Style="{StaticResource ITButtonTextStyle}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </StackPanel>
            
            <!-- チャプター遷移（前へ）ボタン -->
            <Button Command="{Binding PreviousChapterCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="SkipPrevious" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="前のチャプター" Style="{StaticResource ITButtonTextStyle}" FontSize="9"/>
                </StackPanel>
            </Button>
            <!-- 巻き戻しボタン -->
            <Button Command="{Binding RewindCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Rewind10" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="巻き戻し" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 再生ボタン -->
            <Button Command="{Binding PlayCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle2}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Play" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="再生" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 一時停止ボタン（押下後に再生ボタンを押下するとその時点から再生される） -->
            <Button Command="{Binding PauseCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle2}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="Pause" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="一時停止" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- 早送りボタン -->
            <Button Command="{Binding ForwardCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="FastForward10" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="早送り" Style="{StaticResource ITButtonTextStyle}" />
                </StackPanel>
            </Button>
            <!-- チャプター遷移（次へ）ボタン -->
            <Button Command="{Binding NextChapterCommand}" Margin="5"
                    Style="{StaticResource IconTextButtonStyle}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="SkipNext" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="次のチャプター" Style="{StaticResource ITButtonTextStyle}" FontSize="9"/>
                </StackPanel>
            </Button>

        </StackPanel>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,10">
            <!-- 閉じるボタン -->
            <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Content="× 閉じる" Margin="5" Style="{StaticResource CommonButtonStyle}" FontSize="18" VerticalAlignment="Center"
                    Height="45">
            </Button>
        </StackPanel>

    </Grid>
</Window>
