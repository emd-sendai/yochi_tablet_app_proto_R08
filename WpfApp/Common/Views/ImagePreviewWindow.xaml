<Window x:Class="WpfApp.Common.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Title="画像プレビュー" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <DockPanel>
        <!-- 基本ボタン -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- 拡大ボタン-->
            <Button Style="{StaticResource IconTextButtonStyle}" Margin="5,10,5,10" Command="{Binding ZoomInCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="PlusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="拡大" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <!-- 縮小ボタン-->
            <Button Style="{StaticResource IconTextButtonStyle}" Margin="5,10,5,10" Command="{Binding ZoomOutCommand}">
                <StackPanel Orientation="Vertical" >
                    <materialDesign:PackIcon Kind="MinusCircleOutline" Style="{StaticResource ITButtonIconStyle}"/>
                    <TextBlock Text="縮小" Style="{StaticResource ITButtonTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Content="× 画面を閉じる" Style="{StaticResource CommonButtonStyle}"
                    Margin="20,10,10,10" FontSize="15" Height="45" Command="{Binding CloseCommand}" />
        </StackPanel>

        <ScrollViewer x:Name="scrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      Style="{StaticResource MaterialDesignScrollViewer}"
                      CanContentScroll="False" PanningMode="Both"
                      IsManipulationEnabled="True" ManipulationDelta="ScrollViewer_ManipulationDelta">
            <Grid>
                <Image x:Name="image" Source="{Binding Image}" RenderTransformOrigin="0.5,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="imageScale" ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
