<Window x:Class="WpfApp.Common.Views.DocumentSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="表示するファイル名を選択してください" Margin="15" FontSize="18"/>
            <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                     DisplayMemberPath="FileName" FontSize="17" MaxHeight="180" Width="530" 
                     Style="{StaticResource BorderedListBoxStyle}" 
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.PanningMode="VerticalOnly"
                     ScrollViewer.PanningDeceleration="0.001"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="1"  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="キャンセル" Command="{Binding CancelCommand}" Width="100" Height="50" Margin="15" HorizontalAlignment="Center"
                         Style="{StaticResource CommonButtonStyle}" FontSize="17"/>
            <Button Content="表示" Command="{Binding SelectCommand}" Width="80" Height="50" Margin="15" HorizontalAlignment="Center"
                         Style="{StaticResource CommonButtonStyle}" FontSize="19"/>
        </StackPanel>
    </Grid>
</Window>
