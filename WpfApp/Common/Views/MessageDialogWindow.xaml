<Window x:Class="WpfApp.Common.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Common.Views"
        mc:Ignorable="d"
        Title="Message"  Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="NoResize">
    
    <Grid Margin="30">
        <TextBlock Text="{Binding Message}" FontSize="18" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Margin="0,50,0,50"/>
        <Button Content="OK"  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                IsDefault="True" FontSize="22" Height="50" Width="80"
                Command="{Binding OkCommand}" Style="{StaticResource CommonButtonStyle}"/>
    </Grid>
    
</Window>
