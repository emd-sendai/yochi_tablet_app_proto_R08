<Application x:Class="WpfApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfApp"
             xmlns:conv="clr-namespace:WpfApp.Converters"
             xmlns:help="clr-namespace:WpfApp.Helpers">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- カラーパレット -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Indigo.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Secondary/MaterialDesignColor.Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ScrollBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ダブルクリック防止 -->
            <Style TargetType="Button">
                <Setter Property="help:DisableDoubleClickBehavior.IsEnabled" Value="True"/>
            </Style>

            <!-- 基本ボタン様式 -->
            <Style x:Key="CommonButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="Foreground" Value="#3F51B5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- アイコン+テキストボタン様式 -->
            <Style x:Key="IconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="50"/>
            </Style>

            <!-- アイコン+テキストボタン内のアイコン様式 -->
            <Style x:Key="ITButtonIconStyle" TargetType="materialDesign:PackIcon" >
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- アイコン+テキストボタン内のテキスト様式 -->
            <Style x:Key="ITButtonTextStyle" TargetType="TextBlock" >
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 補償のあらまし手順ボタン様式 -->
            <Style x:Key="AramashiButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#1F78B4" />
                <Setter Property="BorderBrush" Value="#1F78B4" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0,0,0,20" />
                <Setter Property="FontSize" Value="15" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#1F78B4" />
                        <Setter Property="Foreground" Value="#1F78B4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 補償のあらまし手順テストボタン様式 -->
            <Style x:Key="AramashiTestButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#1F78B4" />
                <Setter Property="BorderBrush" Value="#1F78B4" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Width" Value="250" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#1F78B4" />
                        <Setter Property="Foreground" Value="#1F78B4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 補償のあらまし手順プレビューボタン様式 -->
            <Style x:Key="AramashiPreviewButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#1F78B4" />
                <Setter Property="BorderBrush" Value="#1F78B4" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Width" Value="190" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- 補償のあらましその他ボタン様式 -->
            <Style x:Key="OthersButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#009E73" />
                <Setter Property="BorderBrush" Value="#009E73" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0,0,0,20" />
                <Setter Property="FontSize" Value="15" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#009E73" />
                        <Setter Property="Foreground" Value="#009E73" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 補償のあらましその他テストボタン様式 -->
            <Style x:Key="OthersTestButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#009E73" />
                <Setter Property="BorderBrush" Value="#009E73" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Width" Value="130" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#009E73" />
                        <Setter Property="Foreground" Value="#009E73" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 各種資料事業ボタン様式 -->
            <Style x:Key="DocumentWorkButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#E69F00" />
                <Setter Property="BorderBrush" Value="#E69F00" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Width" Value="170" />
                <Setter Property="Height" Value="65" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#E69F00" />
                        <Setter Property="Foreground" Value="#E69F00" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 各種資料地権者ボタン様式 -->
            <Style x:Key="DocumentLandownerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="#1F78B4" />
                <Setter Property="BorderBrush" Value="#1F78B4" />
                <Setter Property="Foreground" Value="#FEFEFEFE" />
                <Setter Property="Width" Value="170" />
                <Setter Property="Height" Value="65" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FEFEFEFE" />
                        <Setter Property="BorderBrush" Value="#1F78B4" />
                        <Setter Property="Foreground" Value="#1F78B4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 画像ボタン様式 -->
            <Style x:Key="ImageButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#1F78B4" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="BorderBrush" Value="#3F51B5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- テーブル（遷移用）ボタン様式 -->
            <Style x:Key="TableButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <!-- 通常時の文字色 -->
                <Setter Property="Foreground" Value="#1F78B4"/>
                <Style.Triggers>
                    <!-- ホバー時 -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#1F78B4" />
                    </Trigger>

                    <!-- 押下時（IsPressed） -->
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="#1F78B4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 折り返しテキストブロック様式 -->
            <Style x:Key="WrapTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- 家系図（相続の概要）のアイコン様式 -->
            <Style x:Key="FamilyTreeIconStyle" TargetType="materialDesign:PackIcon" >
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 各種資料コンボボックス様式 -->
            <Style x:Key="DocumentComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="MinHeight" Value="45" />
                <Setter Property="Margin" Value="20,0,20,10" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- リストボックス様式 -->
            <Style x:Key="BorderedListBoxStyle" TargetType="ListBox">
                <Setter Property="BorderBrush" Value="DarkGray"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 表示切替コンバータ（非表示の時空間を詰める） -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- 表示切替コンバータ（非表示の時空間を詰めない） -->
            <conv:BooleanToHiddenVisibilityConverter x:Key="BooleanToHiddenVisibilityConverter" />

            <!-- NULLチェックコンバータ -->
            <conv:NullToBoolConverter x:Key="NullToBoolConverter" />

        </ResourceDictionary>


    </Application.Resources>

</Application>
