<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

	<!-- 配布用自己完結型アプリケーション設定 -->
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishTrimmed>false</PublishTrimmed>
	<PublishReadyToRun>false</PublishReadyToRun>

  </PropertyGroup>

	<!-- アプリケーションの発行後、Releaseフォルダ配下に配布用自己完結型アプリケーションをコピー -->
	<Target Name="AfterPublish">
		<ItemGroup>
			<PublishedFiles Include="$(PublishDir)**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(PublishedFiles)" DestinationFolder="$(ProjectDir)bin\Release\net8.0-windows\" SkipUnchangedFiles="true" Recursive="true" />
	</Target>

  <ItemGroup>
    <None Remove="Data\aramashiButtons.json" />
    <None Remove="Data\Landowners.json" />
    <None Remove="Data\Works.json" />
    <None Remove="SlideResources\Aramashi\slide_Aramashi2.jpg" />
    <None Remove="SlideResources\Others\slides.json" />
    <None Remove="SlideResources\Others\slides_daitaichi.json" />
    <None Remove="SlideResources\Others\slides_zeikin.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\ButtonSettings\aramashiButtons.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\landowners.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\works.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MediaResources\AramashiSample.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SlideResources\Others\slides.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SlideResources\Others\slides_daitaichi.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SlideResources\Others\slides_zeikin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Signature\" />
    <Folder Include="Screens\Admin\Models\" />
    <Folder Include="Screens\Menu\Models\" />
    <Folder Include="Screens\Documents\Models\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SlideResources\Aramashi\aramashi1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Aramashi\aramashi2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Aramashi\slides.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Aramashi\slide_Aramashi1.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Others\daitaichi1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Others\zeikin1.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Others\zeikin2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SlideResources\Others\zeikin3.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
