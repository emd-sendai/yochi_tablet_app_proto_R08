<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

	<!-- 配布用自己完結型アプリケーション設定 -->
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishTrimmed>false</PublishTrimmed>
	<PublishReadyToRun>false</PublishReadyToRun>

  </PropertyGroup>

	<!-- アプリケーションの発行後、Releaseフォルダ配下に配布用自己完結型アプリケーションをコピー -->
	<Target Name="AfterPublish">
		<ItemGroup>
			<PublishedFiles Include="$(PublishDir)**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(PublishedFiles)" DestinationFolder="$(ProjectDir)bin\Release\net8.0-windows\" SkipUnchangedFiles="true" Recursive="true" />
	</Target>

