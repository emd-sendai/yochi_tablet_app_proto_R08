<Project Sdk="WixToolset.Sdk/5.0.2">
	
	<PropertyGroup>
		<!-- プロジェクトタイプ -->
		<OutputType>Package</OutputType>
		<Cultures>ja-jp</Cultures>
		<!-- MSI 出力先 -->
		<OutputPath>bin\Release\</OutputPath>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\WpfApp\WpfApp.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- ProgramFiles 配置用-->
		<HarvestDirectory Include="..\WpfApp\bin\Release\net8.0-windows\win-x64" Recursive="true" TreatAsContent="true">
			<DirectoryRefId>ProgramFilesProductFolder</DirectoryRefId>
			<ComponentGroupName>PublishedFiles</ComponentGroupName>
			<SuppressRootDirectory>true</SuppressRootDirectory>
			<Exclude>zh-Hant\*.*;*.pdb;*.obj;*.tmp</Exclude>
		</HarvestDirectory>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="WixToolset.Heat" Version="5.0.2" />
	</ItemGroup>
	
</Project>